---
/**
 * Authored icon set. One grid (24), one stroke weight (1.4), round caps,
 * no fills — drawn to sit beside the engraved hairlines rather than compete
 * with them. Brand marks are the only filled paths.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
  stroke?: number;
}

const PATHS = {
  goals: `<circle cx="12" cy="12" r="8.2"/><circle cx="12" cy="12" r="4.4"/><circle cx="12" cy="12" r="1"/><path d="M12 3.8V1.6M12 22.4v-2.2M3.8 12H1.6M22.4 12h-2.2"/>`,
  budget: `<path d="M3.4 6.6h17.2v11.8H3.4z"/><path d="M3.4 10.2h17.2"/><circle cx="12" cy="14.4" r="1.9"/><path d="M6.6 14.4h1.4M16 14.4h1.4"/>`,
  protection: `<path d="M12 2.6 4.6 5.8v5.6c0 4.4 3 8.2 7.4 10 4.4-1.8 7.4-5.6 7.4-10V5.8z"/><path d="M8.9 11.9l2.2 2.3 4-4.6"/>`,
  investment: `<path d="M3.2 20.2h17.6"/><path d="M3.2 15.6l4.9-4.9 3.5 3.5 6.1-6.6"/><path d="M13.6 7.6h4.1v4.1"/>`,
  retirement: `<path d="M6.2 4.4v7.2M6.2 11.6h9.4a3.4 3.4 0 0 1 3.4 3.4v1.2"/><path d="M4.4 19.6h15.2"/><path d="M6.2 11.6l-1.4 8M19 16.2l1 3.4"/><circle cx="6.2" cy="3" r="1.4"/>`,
  document: `<path d="M6 2.8h7.4L18.6 8v13.2H6z"/><path d="M13.4 2.8V8h5.2"/><path d="M9 12.6h6.6M9 16.2h6.6"/>`,
  pyramid: `<path d="M12 2.8 21.4 20.4H2.6z"/><path d="M7.9 12.2h8.2M5.3 16.4h13.4"/>`,
  phone: `<path d="M8.1 3.4H5.4a2 2 0 0 0-2 2.2 16.6 16.6 0 0 0 15 15 2 2 0 0 0 2.2-2v-2.7l-4.3-1.5-1.9 2.2a13.4 13.4 0 0 1-6.8-6.8l2.2-1.9z"/>`,
  mail: `<path d="M2.8 5.4h18.4v13.2H2.8z"/><path d="m2.8 6.4 9.2 6.6 9.2-6.6"/>`,
  pin: `<path d="M12 21.4s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10.2" r="2.6"/>`,
  arrow: `<path d="M4.4 12h15.2M13.6 6l6 6-6 6"/>`,
  play: `<circle cx="12" cy="12" r="9.2"/><path d="M10.2 8.4 15.6 12l-5.4 3.6z"/>`,
  check: `<path d="M4.6 12.6l4.6 4.6L19.4 6.8"/>`,
  camera: `<path d="M3 7.8h3.6l1.5-2.2h7.8l1.5 2.2H21v11.4H3z"/><circle cx="12" cy="13.2" r="3.7"/>`,
  facebook: `<path d="M13.4 21.4v-8.2h2.8l.4-3.2h-3.2V7.9c0-.9.3-1.6 1.6-1.6h1.7V3.4a22 22 0 0 0-2.5-.1c-2.6 0-4.3 1.6-4.3 4.4V10H7v3.2h2.9v8.2z"/>`,
  instagram: `<rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.1" cy="6.9" r="1.05" fill="currentColor" stroke="none"/>`,
  linkedin: `<rect x="3.2" y="3.2" width="17.6" height="17.6" rx="2"/><path d="M7.4 10.2v7M7.4 7.1v.1"/><path d="M11.6 17.2v-4a2.6 2.6 0 0 1 5.2 0v4"/><path d="M11.6 10.2v7"/>`,
} as const;

const { name, size = 24, class: className = "", stroke = 1.4 } = Astro.props;
const isBrand = name === "facebook";
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? "currentColor" : "none"}
  stroke={isBrand ? "none" : "currentColor"}
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
