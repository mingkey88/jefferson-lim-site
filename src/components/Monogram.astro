---
import { u } from "../lib/url";

/**
 * Jefferson's own JL monogram.
 *
 * Supplied as artwork with a gold gradient, so it ships as a transparent raster
 * rather than being redrawn as flat SVG. Served at 160px, which covers the
 * largest on-page use (54px) at 3x.
 */
interface Props {
  size?: number;
  class?: string;
  /** Give this only when the mark is the sole content of a link or button. */
  title?: string;
}

const { size = 46, class: className = "", title } = Astro.props;
---

<img
  src={u("/jl-monogram.webp")}
  alt={title ?? ""}
  width={size}
  height={size}
  class={className}
  style={`width:${size}px;height:${size}px`}
  loading="eager"
  decoding="async"
  aria-hidden={title ? undefined : "true"}
/>
