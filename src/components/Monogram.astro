---
/**
 * Circular JL monogram — the seal on the certificate. Double-ruled ring
 * (heavy outer, hairline inner) as engraved seals are struck, with the
 * initials set in the didone display face.
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
}

const { size = 46, class: className = "", title } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  role={title ? "img" : "presentation"}
  aria-label={title}
  aria-hidden={title ? undefined : "true"}
>
  <circle cx="50" cy="50" r="47" stroke="var(--color-gold)" stroke-width="2" />
  <circle cx="50" cy="50" r="41.5" stroke="var(--color-gold)" stroke-width="0.75" stroke-opacity="0.65" />
  <text
    x="50"
    y="50"
    text-anchor="middle"
    dominant-baseline="central"
    fill="var(--color-gold)"
    font-family="'Source Serif 4', Charter, Georgia, serif"
    font-size="38"
    font-style="italic"
    font-weight="500"
    letter-spacing="-1"
  >JL</text>
</svg>
