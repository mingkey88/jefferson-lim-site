---
/**
 * One instance of the guilloché rosette.
 *
 * The geometry lives once per document in GuillocheDefs; this just references
 * it. Instances vary only in overall opacity, so a page with three rosettes
 * pays for the polylines once instead of three times.
 *
 * The `rings` prop is retained for call-site compatibility but no longer
 * changes the figure: at these opacities the difference between four and six
 * rings was not visible, and one shared symbol is what makes the reuse work.
 */
interface Props {
  rings?: number;
  class?: string;
  /** Overall opacity of the whole figure. */
  opacity?: number;
}

const { class: className = "", opacity = 0.4 } = Astro.props;
---

<svg
  class={`guilloche-spin ${className}`}
  viewBox="0 0 600 600"
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
  style={`opacity:${opacity}`}
>
  <use href="#jl-rosette" />
</svg>
