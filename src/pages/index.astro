---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import Guilloche from "../components/Guilloche.astro";
import Icon from "../components/Icon.astro";
import Pending from "../components/Pending.astro";
import { CONTACT, PENDING } from "../consts";

const career = [
  {
    place: "Singapore",
    role: "Business Development, then Audit",
    body: "Started in business development at a construction firm, then spent four years as an auditor — where the habit of tracing every number back to its source became second nature.",
  },
  {
    place: "Seoul",
    role: "Financial Controller",
    body: "Appointed Financial Controller for a Korean company developing an ocean park resort outside Seoul, and helped raise roughly USD 500 million in bonds through the Singapore market to fund it.",
  },
  {
    place: "Ho Chi Minh City",
    role: "Capital Raising",
    body: "Moved to Vietnam and supported a local company raising capital for an industrial and residential park development.",
  },
  {
    place: "Singapore",
    role: "Telecoms, then Public Healthcare",
    body: "Returned home to the telecommunications sector, then moved into public healthcare."
  },
  {
    place: "Singapore",
    role: "Building a Hospital's Finance Function",
    body: "Built the finance department of a new public hospital from the ground up. I retired from corporate life after the hospital officially opened.",
  },
];

const principles = [
  {
    t: "Meticulous, by training",
    d: "Years in audit and corporate finance leave a mark. If a number cannot be traced, it does not go into your plan.",
  },
  {
    t: "Plain language, always",
    d: "If a recommendation cannot be explained simply, it is not ready to be acted on. You should know what you are signing, and why.",
  },
  {
    t: "Your life first, products second",
    d: "We start with your family, your career stage and the legacy you actually want — then look at what could support it.",
  },
  {
    t: "Pace, not pressure",
    d: "You decide when, and whether, to act. I would rather you take your time than take a wrong step.",
  },
];

// Intrinsic dimensions differ per image; the 4:3 display crop is done in CSS,
// so the attributes must carry the file's real size, not the display box.
const gallery = [
  { src: u("/jl-awards.webp"), w: 900, h: 1200, cap: "At the Prudential agency awards night, 2025" },
  { src: u("/jl-volunteer.webp"), w: 900, h: 750, cap: "Volunteering at a Singapore primary school" },
  { src: u("/jl-bhutan.webp"), w: 900, h: 675, cap: "Travelling with friends, Bhutan" },
];
---

<Base
  title="Jefferson Lim | Financial Consultant, Singapore"
  description="Jefferson Lim is a Singapore financial consultant with Lee Jue Rong & Associates. Decades in audit, capital markets and hospital finance, now spent planning for families."
>
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden border-b border-gold/15">
    <div
      class="pointer-events-none absolute -right-[28%] top-1/2 hidden w-[46rem] -translate-y-1/2 opacity-90 md:block lg:-right-[14%]"
      aria-hidden="true"
    >
      <Guilloche rings={6} opacity={0.42} />
    </div>
    <div
      class="pointer-events-none absolute -bottom-28 -right-[48%] w-[28rem] md:hidden"
      aria-hidden="true"
    >
      <Guilloche rings={4} opacity={0.2} />
    </div>

    <div class="shell relative flex min-h-[86svh] flex-col justify-center py-24 md:py-32">
      <h1 class="enter max-w-4xl">
        Financial planning<br class="hidden md:block" />
        is for <span class="flourish">everyone</span>,<br class="hidden md:block" />
        not just the wealthy.
      </h1>

      <div class="rule-orn enter mt-9 max-w-md" style="animation-delay:.12s">
        <span class="rule-orn__mark"></span>
      </div>

      <p class="lede enter prose-measure mt-8" style="animation-delay:.2s">
        I'm Jefferson Lim. I spent decades in audit, capital markets and hospital finance before
        becoming a consultant — including building the finance department of a new Singapore public
        hospital. I plan the financial, legal and healthcare pieces together, so the people you
        love are provided for.
      </p>

      <div class="enter mt-11 flex flex-wrap items-center gap-4" style="animation-delay:.3s">
        <a href={u("/contact")} class="btn btn-gold">
          Start a conversation
          <Icon name="arrow" size={16} stroke={1.7} />
        </a>
        <a href={u("/services")} class="btn btn-outline">See how I help</a>
      </div>

      <ul
        class="mut enter mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 text-xs uppercase tracking-[0.16em]"
        style="animation-delay:.4s"
      >
        <li>Built a public hospital's finance function</li>
        <li class="hidden h-3 w-px bg-gold/30 sm:block" aria-hidden="true"></li>
        <li>{CONTACT.agency}</li>
        <li class="hidden h-3 w-px bg-gold/30 sm:block" aria-hidden="true"></li>
        <li>Prudential Assurance Company Singapore</li>
      </ul>
    </div>
  </section>

  <!-- ===================== WHY I DO THIS ===================== -->
  <section class="shell py-20 md:py-28">
    <div class="grid items-center gap-12 md:grid-cols-12 lg:gap-16">
      <div class="reveal md:col-span-5">
        <div class="relative">
          <div class="absolute -inset-3 border border-gold/25" aria-hidden="true"></div>
          <img
            src={u("/jefferson-portrait.webp")}
            alt="Jefferson Lim, financial consultant"
            width="800"
            height="1200"
            class="relative aspect-[2/3] w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="reveal md:col-span-7">
        <h2>Why I do this.</h2>
        <div class="prose-measure dim mt-7 space-y-5">
          <p>
            With my background in hospital finance, I understand the emotional and financial
            challenges families face during a medical crisis. I have watched, at close range, what
            an unexpected diagnosis does to a household that has nothing in place.
          </p>
          <p>
            So I integrate financial, legal and healthcare planning to help clients protect their
            loved ones, prepare for uncertainty, and build a legacy that means something.
          </p>
        </div>

        <div class="mt-9">
          <a href={u("/services")} class="link-underline">
            The five things we put in place
            <Icon name="arrow" size={15} stroke={1.7} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CAREER LEDGER ===================== -->
  <section class="border-y border-gold/15 bg-ink-850">
    <div class="shell py-20 md:py-28">
      <div class="max-w-2xl">
        <h2 class="reveal">The career before this one.</h2>
        <p class="reveal dim mt-6">
          I became a consultant after retiring from corporate life, because the same gap kept
          appearing: capable, intelligent people — many of them the healthcare professionals I had
          worked alongside — had never been shown how to plan their own affairs.
        </p>
      </div>

      <ol class="mt-14">
        {career.map((c, i) => (
          <li
            class="reveal grid gap-x-10 gap-y-3 border-t border-gold/20 py-8 md:grid-cols-12 md:py-9"
            style={`transition-delay:${i * 70}ms`}
          >
            <div class="order-2 mt-1 md:order-1 md:col-span-3 md:mt-0">
              <span class="meta">{c.place}</span>
            </div>
            <div class="order-1 md:order-2 md:col-span-9">
              <h3>{c.role}</h3>
              <p class="dim prose-measure mt-3">{c.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== PRINCIPLES ===================== -->
  <section class="shell py-20 md:py-28">
    <h2 class="reveal max-w-xl">How I work.</h2>
    <div class="mt-12 grid gap-x-14 gap-y-10 md:grid-cols-2">
      {principles.map((p, i) => (
        <div class="reveal" style={`transition-delay:${i * 80}ms`}>
          <div class="rule-orn max-w-[4.5rem]"><span class="rule-orn__mark"></span></div>
          <h3 class="mt-5">{p.t}</h3>
          <p class="dim mt-3">{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== BEYOND THE DESK ===================== -->
  <section class="border-t border-gold/15 bg-ink-850">
    <div class="shell py-20 md:py-28">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="reveal md:col-span-5">
          <h2>A life, not just a practice.</h2>
        </div>
        <p class="reveal dim md:col-span-7 md:pt-3">
          When I am not advising clients, I volunteer in schools, supporting numeracy and mentoring
          students. Otherwise I travel as often as I can, across Asia and Europe. At home: leather
          crafting, Muay Thai, cycling, trekking.
        </p>
      </div>

      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {gallery.map((g, i) => (
          <li class="reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="border border-gold/20 p-2">
              <img
                src={g.src}
                alt={g.cap}
                width={g.w}
                height={g.h}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
            </div>
            <p class="meta mt-3">{g.cap}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== TESTIMONIAL ===================== -->
  {PENDING.testimonial && (
    <section class="shell py-16 md:py-20">
      <div class="reveal mx-auto max-w-3xl">
        <h2 class="text-center text-[1.6rem] md:text-[2rem]">In a client's own words</h2>
        <div class="rule-orn mx-auto mt-5 max-w-[10rem]"><span class="rule-orn__mark"></span></div>
        <div class="mt-8">
          <Pending>
            Jefferson needs to supply the quote and the attribution (name and role), and both must
            clear Prudential's compliance review before this section can go live.
          </Pending>
        </div>
      </div>
    </section>
  )}

  <!-- ===================== CTA ===================== -->
  <section class="relative isolate overflow-hidden border-t border-gold/20 bg-ink-950">
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 w-[38rem] -translate-x-1/2 -translate-y-1/2"
      aria-hidden="true"
    >
      <Guilloche rings={4} opacity={0.22} />
    </div>
    <div class="shell relative py-24 text-center md:py-32">
      <h2 class="mx-auto max-w-2xl">Curious whether we would work well together?</h2>
      <p class="dim mx-auto mt-6 max-w-xl">
        A short conversation is the easiest way to find out. Nothing to prepare, and nothing owed
        at the end of it.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={u("/contact")} class="btn btn-gold">
          Start a conversation
          <Icon name="arrow" size={16} stroke={1.7} />
        </a>
        <a href={CONTACT.phoneHref} class="btn btn-outline">
          <Icon name="phone" size={15} stroke={1.6} />
          {CONTACT.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
