---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import Guilloche from "../components/Guilloche.astro";
import Monogram from "../components/Monogram.astro";
import Icon from "../components/Icon.astro";
import Pending from "../components/Pending.astro";
import { CONTACT } from "../consts";

/**
 * Standalone landing page for paid traffic. No site navigation by design —
 * a funnel page has one exit. Copy is adapted from Jefferson's existing ad
 * funnel, with the outcome claims ("attain early retirement", "bring your
 * retirement forward by years") and the unevidenced "set up a government
 * hospital and many healthcare institutions" line removed. Noindexed so it
 * does not compete with /services in search.
 */
const year = new Date().getFullYear();
---

<Base
  bare
  robots="noindex, follow"
  title="Jefferson Lim | Financial Consultant, Singapore"
  description="Jefferson Lim, financial consultant. Financial, legal and healthcare planning for healthcare professionals in Singapore."
>
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden border-b border-gold/15">
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 w-[52rem] -translate-x-1/2 -translate-y-1/2 opacity-70"
      aria-hidden="true"
    >
      <Guilloche rings={6} opacity={0.24} />
    </div>

    <div class="shell-tight relative py-16 text-center md:py-24">
      <a href={u("/")} class="enter inline-block" aria-label={`${CONTACT.name}, home`}>
        <Monogram size={56} class="mx-auto" />
      </a>

      <h1 class="enter mt-10" style="animation-delay:.1s">
        The retirement question most healthcare professionals
        <span class="flourish">never</span> get help with.
      </h1>

      <div class="rule-orn enter mx-auto mt-8 max-w-xs" style="animation-delay:.18s">
        <span class="rule-orn__mark"></span>
      </div>

      <p class="lede enter mx-auto mt-8 max-w-2xl" style="animation-delay:.24s">
        For healthcare professionals in their 40s and 50s. Without sacrificing more family time.
      </p>

      <div class="enter mt-10" style="animation-delay:.32s">
        <a href="#how-i-help" class="btn btn-gold">
          See how this works
          <Icon name="arrow" size={16} stroke={1.7} />
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== WHO AM I ===================== -->
  <section class="border-b border-gold/15 bg-ink-850">
    <div class="shell py-20 md:py-24">
      <div class="grid items-center gap-12 md:grid-cols-12 lg:gap-16">
        <div class="reveal md:col-span-5">
          <div class="relative">
            <div class="absolute -inset-3 border border-gold/25" aria-hidden="true"></div>
            <img
              src={u("/jefferson-portrait.webp")}
              alt="Jefferson Lim, financial consultant"
              width="1000"
              height="1484"
              class="relative aspect-[2/3] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div class="reveal md:col-span-7">
          <h2>Where I come from.</h2>
          <p class="lede prose-measure mt-7">
            I am Jefferson Lim, a financial consultant. I spent my corporate career in finance,
            including building the finance function of a new Singapore public hospital. That is
            where I saw how rarely healthcare staff get to plan their own affairs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHY I'M DOING THIS ===================== -->
  <section class="shell-tight py-20 md:py-28">
    <h2 class="reveal">Why I do this.</h2>
    <div class="rule-orn reveal mt-7 max-w-xs"><span class="rule-orn__mark"></span></div>

    <div class="dim mt-9 space-y-6">
      <p class="reveal">
        After decades in finance, including building the finance function of a new Singapore
        public hospital, I saw how many healthcare staff burn out on the long hours.
      </p>
      <p class="reveal">
        Missing family events, no work-life balance, and relentless career competition seem to be
        the price you are expected to pay.
      </p>
      <p class="reveal text-paper">
        Most of them simply want to retire early. Few know how to get there, especially when
        nobody ever taught them how to make good financial decisions.
      </p>
      <p class="reveal">
        Most of it comes down to being specific about what you want, early enough to act on it,
        and doing that without giving up more family time.
      </p>
    </div>
  </section>

  <!-- ===================== HOW I CAN HELP ===================== -->
  <section id="how-i-help" class="relative isolate scroll-mt-8 overflow-hidden border-y border-gold/20 bg-ink-950">
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 w-[40rem] -translate-x-1/2 -translate-y-1/2"
      aria-hidden="true"
    >
      <Guilloche rings={4} opacity={0.2} />
    </div>
    <div class="shell-tight relative py-24 text-center md:py-28">
      <h2 class="mx-auto max-w-2xl">What a first conversation covers.</h2>
      <p class="dim mx-auto mt-7 max-w-xl">
        A one-to-one conversation about where you are now, what you would like to put in place,
        and what has been on your mind. No obligation.
      </p>
      <p class="mut mx-auto mt-5 max-w-xl text-sm">
        I take a limited number of these each month, so there may be a short wait.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={u("/contact")} class="btn btn-gold">
          Start a conversation
          <Icon name="arrow" size={16} stroke={1.7} />
        </a>
        <a href={CONTACT.phoneHref} class="btn btn-outline">
          <Icon name="phone" size={15} stroke={1.6} />
          {CONTACT.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== COMPLIANCE FOOTER ===================== -->
  <footer class="shell py-14">
    <div class="mx-auto max-w-2xl text-center">
      <address class="mut space-y-1 text-sm not-italic">
        <p class="text-paper">{CONTACT.agency}</p>
        <p>{CONTACT.agencyNote}</p>
        <p class="pt-2">{CONTACT.addressLines.join(", ")}</p>
        <p>
          <a href={CONTACT.phoneHref} class="transition-colors hover:text-gold">{CONTACT.phone}</a>
        </p>
      </address>

      {/*
        Jefferson: this is a NEW advertising creative and needs its own Prudential
        approval code. The existing funnel's code (AT27Sep24FF27) covers the old
        page only. Also confirm the office address: the live funnel still shows
        51 Scotts Road / DID 9383 0563, while the design brief gives
        1 Pasir Panjang Road / 9298 8326 (used here).
      */}
      <div class="mx-auto mt-7 max-w-xl">
        <Pending>
          this advertising creative needs its own Prudential approval code before it goes live.
        </Pending>
      </div>

      <p class="mut mt-7 text-xs leading-relaxed">
        &copy; {year} {CONTACT.name}. All rights reserved.
      </p>
      <p class="mut mx-auto mt-3 max-w-lg text-[0.68rem] leading-relaxed">
        This site is not part of the Facebook website and is not endorsed by Meta Platforms, Inc.
        Facebook is a registered trademark of Meta Platforms, Inc.
      </p>
    </div>
  </footer>
</Base>
