---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import Guilloche from "../components/Guilloche.astro";
import Icon from "../components/Icon.astro";
import PhotoSlot from "../components/PhotoSlot.astro";
import { CONTACT } from "../consts";

/**
 * The five pillars, in the order they get built.
 *
 * NOTE: these descriptions are shortened from Jefferson's original wording.
 * The meaning is unchanged but the phrasing is no longer his verbatim copy,
 * so it needs a read-through with him before launch.
 */
const pillars = [
  {
    icon: "goals",
    t: "Financial Goals Defined",
    lead: "Clarity creates confidence.",
    d: "Knowing what you are actually planning for. Your family, a home, your children's education, retiring on time. Once that is clear, every other decision gets easier.",
    photo: "A planning conversation. Notes, a coffee, two people talking.",
  },
  {
    icon: "budget",
    t: "Budget Managed",
    lead: "The foundation of peace of mind.",
    d: "Where your income actually goes each month. Daily needs, savings, investments, and what is coming later. This is the part most people skip.",
    photo: "Something everyday and household. Kitchen table, laptop, bills.",
  },
  {
    icon: "protection",
    t: "Protection Secured",
    lead: "Stability during uncertain times.",
    d: "Cover for the things that would otherwise undo everything else. Your income, your health, your family, your assets.",
    photo: "A family together. Warm, ordinary, nothing staged.",
    detail: {
      label: "The legal and healthcare instruments a plan has to account for",
      items: [
        ["Will", "Your written wishes, recorded."],
        ["LPA", "Lasting Power of Attorney. Who decides, if you cannot."],
        ["AMD", "Advance Medical Directive. Your stance on life-sustaining treatment."],
        ["ACP", "Advance Care Planning. Your values, to guide those you love."],
      ],
    },
  },
  {
    icon: "investment",
    t: "Investment Growing",
    lead: "Money that works while you do.",
    d: "Putting money to work over a long horizon, so inflation does not quietly undo your savings.",
    photo: "A long view. Skyline, horizon, something with distance in it.",
  },
  {
    icon: "retirement",
    t: "Retirement Planned",
    lead: "Life on your own terms.",
    d: "An income you can count on once you stop working, started early enough to be comfortable.",
    photo: "Retirement as his clients picture it. Travel, grandchildren, time.",
  },
] as const;

const steps = [
  { t: "A conversation", d: "We talk about where you are and what has been on your mind. No obligation." },
  { t: "A written plan", d: "If it makes sense to continue, I write up your situation and the options worth looking at." },
  { t: "You decide", d: "What to act on, when, and how much. Reviews happen when your life changes." },
];
---

<Base
  title="My Services | Jefferson Lim, Financial Consultant"
  description="Five pillars of financial planning for Singapore families: goals, budget, protection, investment and retirement. Plan today, enjoy tomorrow."
>
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden border-b border-gold/15">
    <div class="shell relative py-20 md:py-24">
      <div class="grid items-center gap-14 md:grid-cols-12">
        <div class="md:col-span-7">
          <h1 class="enter">
            The five things<br class="hidden md:block" />
            I put in place.
          </h1>
          <div class="rule-orn enter mt-8 max-w-sm" style="animation-delay:.12s">
            <span class="rule-orn__mark"></span>
          </div>
          <p class="lede enter prose-measure mt-7" style="animation-delay:.2s">
            Good planning is not one product. It is five things standing up together, and we start
            wherever you actually are.
          </p>
          <div class="enter mt-10" style="animation-delay:.3s">
            <a href={u("/contact")} class="btn btn-gold">
              Start a conversation
              <Icon name="arrow" size={16} stroke={1.7} />
            </a>
          </div>
        </div>

        <!-- The engraved schedule, as drawn in the client's brief -->
        <div class="enter md:col-span-5" style="animation-delay:.24s">
          <div class="plate-deep relative isolate overflow-hidden p-8 md:p-9">
            <div
              class="pointer-events-none absolute -right-24 -top-24 w-72 opacity-60"
              aria-hidden="true"
            >
              <Guilloche rings={3} opacity={0.3} />
            </div>
            <p class="relative font-display text-2xl leading-[1.25] text-gold">
              Peace of mind.<br /><span class="text-paper">All plans in place.</span>
            </p>
            <ul class="relative mt-7 space-y-4">
              {pillars.map((p) => (
                <li class="flex items-center gap-3.5 border-b border-gold/15 pb-4 last:border-0 last:pb-0">
                  <Icon name={p.icon} size={21} class="shrink-0 text-gold" stroke={1.3} />
                  <span class="text-[0.95rem] text-paper">{p.t}</span>
                </li>
              ))}
            </ul>
            <p class="relative mt-7 font-display text-xl italic text-gold">
              Plan today, enjoy tomorrow.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== THE FIVE PILLARS ===================== -->
  <section class="shell py-14 md:py-20">
    <ol class="space-y-14 md:space-y-20">
      {pillars.map((p, i) => (
        <li class="reveal grid items-center gap-8 border-t border-gold/20 pt-12 md:grid-cols-12 md:gap-12 md:pt-16">
          <PhotoSlot class={`md:col-span-5 ${i % 2 === 1 ? "md:order-2" : ""}`} label={p.photo} />

          <div class={`md:col-span-7 ${i % 2 === 1 ? "md:order-1" : ""}`}>
            <div class="flex items-baseline gap-4">
              <span class="denom text-4xl md:text-5xl">{String(i + 1).padStart(2, "0")}</span>
              <h2 class="text-[1.75rem] md:text-[2.2rem]">{p.t}</h2>
            </div>
            <p class="mt-3 font-display text-lg italic text-paper md:text-xl">{p.lead}</p>
            <p class="dim prose-measure mt-4">{p.d}</p>

            {p.detail && (
              <div class="plate mt-7 p-6">
                <p class="meta text-gold">{p.detail.label}</p>
                <dl class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
                  {p.detail.items.map(([term, desc]) => (
                    <div class="flex gap-3.5">
                      <dt class="denom w-12 shrink-0 pt-0.5 text-lg">{term}</dt>
                      <dd class="dim text-sm">{desc}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="border-y border-gold/15 bg-ink-850">
    <div class="shell py-20 md:py-24">
      <h2 class="reveal max-w-xl">A simple, unhurried process.</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-12">
        {steps.map((s, i) => (
          <div class="reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="denom text-4xl">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-4 border-t border-gold/20 pt-5">{s.t}</h3>
            <p class="dim mt-2">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="relative isolate overflow-hidden bg-ink-950">
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 w-[36rem] -translate-x-1/2 -translate-y-1/2"
      aria-hidden="true"
    >
      <Guilloche rings={4} opacity={0.2} />
    </div>
    <div class="shell relative py-24 text-center md:py-28">
      <h2 class="mx-auto max-w-2xl">Not sure which of the five you are missing?</h2>
      <p class="dim mx-auto mt-6 max-w-xl">
        That is normal, and it is exactly what a first conversation is for.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={u("/contact")} class="btn btn-gold">
          Start a conversation
          <Icon name="arrow" size={16} stroke={1.7} />
        </a>
        <a href={CONTACT.phoneHref} class="btn btn-outline">
          <Icon name="phone" size={15} stroke={1.6} />
          {CONTACT.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
