---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import Guilloche from "../components/Guilloche.astro";
import Icon from "../components/Icon.astro";
import { CONTACT } from "../consts";

/** The five pillars, in the order they are actually built. Client copy. */
const pillars = [
  {
    icon: "goals",
    t: "Financial Goals Defined",
    lead: "Clarity creates confidence.",
    d: "Defining your financial goals helps you understand what truly matters — whether that is providing for your family, owning your dream home, funding your children's education, or retiring comfortably. With clear goals, every financial decision becomes more purposeful and aligned with the life you want to build.",
  },
  {
    icon: "budget",
    t: "Budget Managed",
    lead: "The foundation of peace of mind.",
    d: "A well-managed budget ensures your income is directed wisely toward daily needs, savings, investments and future priorities. By keeping spending intentional and sustainable, you gain greater control over your finances and reduce unnecessary stress.",
  },
  {
    icon: "protection",
    t: "Protection Secured",
    lead: "Stability during uncertain times.",
    d: "Life is unpredictable, but proper protection holds steady. Insurance and risk management safeguard your loved ones, income, health and assets against unexpected events. Knowing your family is financially protected lets you focus on living with confidence.",
    detail: {
      label: "The legal and healthcare instruments a plan has to account for",
      items: [
        ["Will", "Your written wishes, recorded."],
        ["LPA", "Lasting Power of Attorney — who decides, if you cannot."],
        ["AMD", "Advance Medical Directive — your stance on life-sustaining treatment."],
        ["ACP", "Advance Care Planning — your values, to guide those you love."],
      ],
    },
  },
  {
    icon: "investment",
    t: "Investment Growing",
    lead: "Money that works while you do.",
    d: "Through disciplined, long-term investing you can grow wealth steadily to reach important milestones and stay ahead of inflation. A well-structured strategy turns today's efforts into tomorrow's opportunities and financial freedom.",
  },
  {
    icon: "retirement",
    t: "Retirement Planned",
    lead: "Life on your own terms.",
    d: "Retirement planning is about creating freedom in the years ahead. By preparing early and consistently you build a sustainable income stream that supports the lifestyle you want, and can look forward to the future with confidence rather than uncertainty.",
  },
] as const;

const steps = [
  {
    t: "A conversation",
    d: "A no-obligation conversation about where you are now, what you would like to put in place, and what has been on your mind.",
  },
  {
    t: "A written plan",
    d: "If it makes sense to go further, I put together a written view of your situation and the options worth exploring, in language you can actually check.",
  },
  {
    t: "You decide, at your pace",
    d: "You choose what to act on, when, and how much. Reviews happen as your life and family change — not on a fixed sales calendar.",
  },
];
---

<Base
  title="My Services | Jefferson Lim, Financial Consultant"
  description="Five pillars of financial planning — goals, budget, protection, investment and retirement — for Singapore families. Plan today, enjoy tomorrow."
>
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden border-b border-gold/15">
    <div class="shell relative py-20 md:py-28">
      <div class="grid items-center gap-14 md:grid-cols-12">
        <div class="md:col-span-7">
          <h1 class="enter">
            The five things<br class="hidden md:block" />
            I put in place.
          </h1>
          <div class="rule-orn enter mt-8 max-w-sm" style="animation-delay:.12s">
            <span class="rule-orn__mark"></span>
          </div>
          <p class="lede enter prose-measure mt-7" style="animation-delay:.2s">
            Good planning is not one product. It is five things standing up together. This is the
            order I build them in, and we start wherever you actually are.
          </p>
          <div class="enter mt-10" style="animation-delay:.3s">
            <a href={u("/contact")} class="btn btn-gold">
              Start a conversation
              <Icon name="arrow" size={16} stroke={1.7} />
            </a>
          </div>
        </div>

        <!-- The engraved schedule, as drawn in the client's brief -->
        <div class="enter md:col-span-5" style="animation-delay:.24s">
          <div class="plate-deep relative isolate overflow-hidden p-8 md:p-9">
            <div
              class="pointer-events-none absolute -right-24 -top-24 w-72 opacity-60"
              aria-hidden="true"
            >
              <Guilloche rings={3} opacity={0.3} />
            </div>
            <p class="relative font-display text-2xl leading-[1.25] text-gold">
              Peace of mind.<br /><span class="text-paper">All plans in place.</span>
            </p>
            <ul class="relative mt-7 space-y-4">
              {pillars.map((p) => (
                <li class="flex items-center gap-3.5 border-b border-gold/15 pb-4 last:border-0 last:pb-0">
                  <Icon name={p.icon} size={21} class="shrink-0 text-gold" stroke={1.3} />
                  <span class="text-[0.95rem] text-paper">{p.t}</span>
                </li>
              ))}
            </ul>
            <p class="relative mt-7 font-display text-xl italic text-gold">
              Plan today, enjoy tomorrow.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== THE FIVE PILLARS ===================== -->
  <section class="shell py-16 md:py-24">
    <ol>
      {pillars.map((p, i) => (
        <li class="reveal grid gap-x-12 gap-y-6 border-t border-gold/20 py-12 md:grid-cols-12 md:py-16">
          <div class="flex items-start gap-6 md:col-span-4 md:flex-col md:gap-7">
            <span class="denom text-6xl md:text-7xl">{String(i + 1).padStart(2, "0")}</span>
            <Icon name={p.icon} size={44} class="text-gold/70" stroke={1.1} />
          </div>

          <div class="md:col-span-8">
            <h2 class="text-[1.9rem] md:text-[2.35rem]">{p.t}</h2>
            <p class="mt-3 font-display text-xl italic text-paper">{p.lead}</p>
            <p class="dim prose-measure mt-5">{p.d}</p>

            {p.detail && (
              <div class="plate mt-8 p-6 md:p-7">
                <p class="meta text-gold">{p.detail.label}</p>
                <dl class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
                  {p.detail.items.map(([term, desc]) => (
                    <div class="flex gap-3.5">
                      <dt class="denom w-12 shrink-0 pt-0.5 text-lg">{term}</dt>
                      <dd class="dim text-sm">{desc}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="border-y border-gold/15 bg-ink-850">
    <div class="shell py-20 md:py-28">
      <h2 class="reveal max-w-xl">A simple, unhurried process.</h2>
      <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-12">
        {steps.map((s, i) => (
          <div class="reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="denom text-4xl">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-4 border-t border-gold/20 pt-5">{s.t}</h3>
            <p class="dim mt-3">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="relative isolate overflow-hidden bg-ink-950">
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 w-[36rem] -translate-x-1/2 -translate-y-1/2"
      aria-hidden="true"
    >
      <Guilloche rings={4} opacity={0.2} />
    </div>
    <div class="shell relative py-24 text-center md:py-32">
      <h2 class="mx-auto max-w-2xl">Not sure which of the five you are missing?</h2>
      <p class="dim mx-auto mt-6 max-w-xl">
        That is normal, and it is exactly what a first conversation is for.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={u("/contact")} class="btn btn-gold">
          Start a conversation
          <Icon name="arrow" size={16} stroke={1.7} />
        </a>
        <a href={CONTACT.phoneHref} class="btn btn-outline">
          <Icon name="phone" size={15} stroke={1.6} />
          {CONTACT.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
